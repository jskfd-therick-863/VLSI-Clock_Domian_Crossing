# Clock domain crossing report - POST-FIX - design hack_top
# One CDC record per structural crossing found by the static CDC engine.
SIGNOFF_DATE 2026-09-01
FAST_CLOCK_PERIOD_NS 3.0      # destinations faster than this need SYNC_FF >= 3

CDC_ID C01 SRC_CLK clk_cpu DST_CLK clk_bus SIGNAL req TYPE SINGLE_BIT SYNC_FF 2 SCHEME TWO_FF BUNDLE B_REQ
CDC_ID C02 SRC_CLK clk_cpu DST_CLK clk_bus SIGNAL data[7:0] TYPE MULTI_BIT SYNC_FF 0 SCHEME FIFO BUNDLE B_REQ
CDC_ID C03 SRC_CLK clk_bus DST_CLK clk_cpu SIGNAL ack TYPE SINGLE_BIT SYNC_FF 3 SCHEME TWO_FF BUNDLE B_ACK
CDC_ID C04 SRC_CLK clk_cpu DST_CLK clk_io SIGNAL cfg[3:0] TYPE MULTI_BIT SYNC_FF 0 SCHEME FIFO BUNDLE NONE
CDC_ID C05 SRC_CLK clk_io DST_CLK clk_cpu SIGNAL status TYPE SINGLE_BIT SYNC_FF 3 SCHEME TWO_FF BUNDLE NONE
CDC_ID C06 SRC_CLK clk_dsp DST_CLK clk_bus SIGNAL fifo_wr TYPE SINGLE_BIT SYNC_FF 2 SCHEME TWO_FF BUNDLE B_FIFO
CDC_ID C07 SRC_CLK clk_dsp DST_CLK clk_bus SIGNAL fifo_data[15:0] TYPE MULTI_BIT SYNC_FF 0 SCHEME GRAY BUNDLE B_FIFO
CDC_ID C08 SRC_CLK clk_bus DST_CLK clk_dsp SIGNAL fifo_rd TYPE SINGLE_BIT SYNC_FF 2 SCHEME TWO_FF BUNDLE B_FIFO
CDC_ID C09 SRC_CLK clk_cpu DST_CLK clk_cpu_div2 SIGNAL sync_sig TYPE SINGLE_BIT SYNC_FF 0 SCHEME NONE BUNDLE NONE
CDC_ID C10 SRC_CLK clk_io DST_CLK clk_bus SIGNAL io_irq TYPE SINGLE_BIT SYNC_FF 2 SCHEME TWO_FF BUNDLE NONE
CDC_ID C11 SRC_CLK clk_cpu DST_CLK clk_dsp SIGNAL start TYPE SINGLE_BIT SYNC_FF 2 SCHEME TWO_FF BUNDLE B_START
CDC_ID C12 SRC_CLK clk_dsp DST_CLK clk_cpu SIGNAL done TYPE SINGLE_BIT SYNC_FF 3 SCHEME TWO_FF BUNDLE B_START
CDC_ID C13 SRC_CLK clk_cpu DST_CLK clk_io SIGNAL rst_io TYPE RESET SYNC_FF 0 SCHEME RESET_SYNC BUNDLE NONE
CDC_ID C14 SRC_CLK clk_bus DST_CLK clk_io SIGNAL bus_rst TYPE RESET SYNC_FF 0 SCHEME RESET_SYNC BUNDLE NONE
CDC_ID C15 SRC_CLK clk_io DST_CLK clk_dsp SIGNAL io_data[7:0] TYPE MULTI_BIT SYNC_FF 0 SCHEME HANDSHAKE BUNDLE NONE
CDC_ID C16 SRC_CLK clk_dsp DST_CLK clk_io SIGNAL dsp_valid TYPE SINGLE_BIT SYNC_FF 2 SCHEME TWO_FF BUNDLE B_DSPIO
CDC_ID C17 SRC_CLK clk_dsp DST_CLK clk_io SIGNAL dsp_data[31:0] TYPE MULTI_BIT SYNC_FF 0 SCHEME GRAY BUNDLE B_DSPIO
CDC_ID C18 SRC_CLK clk_bus DST_CLK clk_cpu SIGNAL err_flag TYPE SINGLE_BIT SYNC_FF 3 SCHEME TWO_FF BUNDLE NONE
CDC_ID C19 SRC_CLK clk_cpu DST_CLK clk_bus SIGNAL mode[1:0] TYPE MULTI_BIT SYNC_FF 0 SCHEME GRAY BUNDLE B_MODE
CDC_ID C20 SRC_CLK clk_bus DST_CLK clk_cpu SIGNAL mode_ack TYPE SINGLE_BIT SYNC_FF 3 SCHEME TWO_FF BUNDLE B_MODE
CDC_ID C21 SRC_CLK clk_cpu DST_CLK clk_bus SIGNAL ctrl_a TYPE SINGLE_BIT SYNC_FF 2 SCHEME HANDSHAKE BUNDLE B_CTRL
CDC_ID C22 SRC_CLK clk_cpu DST_CLK clk_bus SIGNAL ctrl_b TYPE SINGLE_BIT SYNC_FF 2 SCHEME HANDSHAKE BUNDLE B_CTRL
